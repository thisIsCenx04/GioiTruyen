{
  "name": "@gioitruyen/workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=20.9.0 <27",
    "pnpm": ">=11.12.0 <12"
  },
  "scripts": {
    "build": "pnpm --filter \"./apps/*\" build",
    "dev:web": "pnpm --filter @gioitruyen/web dev",
    "dev:admin": "pnpm --filter @gioitruyen/admin dev",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm test:unit",
    "test:coverage": "node ./scripts/run-vitest.mjs run --coverage",
    "test:policy": "node ./scripts/enforce-test-policy.mjs",
    "test:policy:self-test": "node ./scripts/run-vitest.mjs run test/policy --reporter=default",
    "test:report:merge": "node ./scripts/merge-test-reports.mjs",
    "test:unit": "node ./scripts/run-vitest.mjs run",
    "test:unit:changed": "node ./scripts/run-vitest.mjs run --changed --reporter=default",
    "test:watch": "node ./scripts/run-vitest.mjs",
    "typecheck": "pnpm -r --if-present typecheck && pnpm typecheck:policy",
    "typecheck:policy": "tsc --project tsconfig.test.json"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.11",
    "jsdom": "29.1.1",
    "msw": "2.15.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
