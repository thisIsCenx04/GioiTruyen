{
  "name": "story_search_v1",
  "collectionName": "stories",
  "database": "${MONGODB_DATABASE}",
  "definition": {
    "mappings": {
      "dynamic": false,
      "fields": {
        "_id": {
          "type": "token"
        },
        "aliases": {
          "type": "string"
        },
        "categoryIds": {
          "type": "token"
        },
        "completionStatus": {
          "type": "token"
        },
        "origin": {
          "type": "token"
        },
        "synopsis": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "workflowStatus": {
          "type": "token"
        }
      }
    },
    "storedSource": {
      "include": [
        "_id",
        "teamId",
        "slug",
        "title",
        "coverAssetId",
        "publishedAt"
      ]
    }
  }
}
