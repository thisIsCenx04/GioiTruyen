# Copy to .env for local development. Never commit real values.

APP_NAME=story-platform
APP_ENV=local
APP_VERSION=dev
APP_TIMEZONE=UTC
LOG_LEVEL=INFO
LOG_FORMAT=ecs

API_HOST=127.0.0.1
API_PORT=8080
API_BASE_URL=http://127.0.0.1:8080/api/v1
API_INTERNAL_URL=http://127.0.0.1:8080/api/v1
WEB_HOST=127.0.0.1
WEB_PORT=3000
WEB_BASE_URL=http://127.0.0.1:3000
ADMIN_BASE_URL=http://127.0.0.1:3001

MONGODB_URI=mongodb://127.0.0.1:27017/story_platform?replicaSet=rs0
MONGODB_DATABASE=story_platform
MONGODB_MIN_POOL_SIZE=2
MONGODB_MAX_POOL_SIZE=50
MONGODB_MAX_CONNECTING=4
MONGODB_MAX_WAIT_TIME=2s
MONGODB_MAX_IDLE_TIME=60s
MONGODB_CONNECT_TIMEOUT=2s
MONGODB_READ_TIMEOUT=5s
MONGODB_SERVER_SELECTION_TIMEOUT=3s
MONGODB_WRITE_TIMEOUT=5s
SEARCH_BACKEND=text
ATLAS_SEARCH_INDEX=story_search_v1
SUGGESTION_RATE_LIMIT_MAXIMUM=30
SUGGESTION_RATE_LIMIT_WINDOW=1m
MONGODB_MIGRATIONS_ENABLED=false
MONGODB_MIGRATIONS_DRY_RUN=true
MONGODB_MIGRATIONS_LOCK_DURATION=15m
OUTBOX_MAX_PAYLOAD_BYTES=65536
OUTBOX_WORKER_ENABLED=false
OUTBOX_WORKER_BATCH_SIZE=25
OUTBOX_WORKER_LEASE_DURATION=30s
OUTBOX_WORKER_POLL_INTERVAL=1s
OUTBOX_WORKER_MAX_ATTEMPTS=8
OUTBOX_WORKER_INITIAL_BACKOFF=1s
OUTBOX_WORKER_MAX_BACKOFF=15m
REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_TIMEOUT=500ms
REDIS_OPERATION_TIMEOUT=250ms
REDIS_KEY_PREFIX=gioitruyen
REDIS_KEY_VERSION=v1
REDIS_MINIMUM_CACHE_TTL=30s
REDIS_MAXIMUM_CACHE_TTL=60m
REDIS_TTL_JITTER_RATIO=0.1

JWT_ISSUER=story-platform-local
JWT_AUDIENCE=story-platform-local
JWT_SIGNING_KEY=replace-with-base64-encoded-32-byte-key
JWT_ACCESS_TOKEN_TTL=10m
MFA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
REAUTHENTICATION_GRANT_TTL=5m
LOGIN_RISK_HMAC_KEY=replace-with-base64-encoded-32-byte-key
LOGIN_MAX_EMAIL_FAILURES=5
LOGIN_MAX_ADDRESS_FAILURES=20
LOGIN_RISK_WINDOW=15m
REFRESH_SESSION_TTL=30d
REFRESH_SESSION_MAX_GENERATIONS=500
DATA_ENCRYPTION_KEY=change-me-minimum-32-random-bytes
EMAIL_VERIFICATION_HMAC_KEY=replace-with-base64-encoded-32-byte-key
EMAIL_VERIFICATION_TOKEN_TTL=24h

CLOUDINARY_CLOUD_NAME=change-me
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me
CLOUDINARY_WEBHOOK_SECRET=change-me
CLOUDINARY_UPLOAD_SIGNING_ENABLED=false
CLOUDINARY_UPLOAD_PRESET=gioitruyen_restricted
CLOUDINARY_ROOT_FOLDER=gioitruyen/local
CLOUDINARY_SIGNATURE_TTL=55m
CLOUDINARY_WEBHOOK_ENABLED=false
CLOUDINARY_WEBHOOK_MAX_AGE=2h
CLOUDINARY_PROCESSING_ENABLED=false
CLOUDINARY_PROCESSING_LEASE_DURATION=30s
CLOUDINARY_PROCESSING_RETRY_DELAY=30s
CLOUDINARY_PROCESSING_POLL_INTERVAL=2s
CLOUDINARY_PROCESSING_TIMEOUT=15s
CLOUDINARY_PROCESSING_MAX_ATTEMPTS=5

PUBLISHING_PRECHECKS_ENABLED=false
PUBLISHING_PRECHECK_LEASE_DURATION=30s
PUBLISHING_PRECHECK_TIMEOUT=5s
PUBLISHING_PRECHECK_POLL_INTERVAL=2s
PUBLISHING_DUE_WORKER_ENABLED=false
PUBLISHING_DUE_LEASE_DURATION=30s
PUBLISHING_DUE_INACTIVE_RETRY_DELAY=5m
PUBLISHING_DUE_POLL_INTERVAL=2s
PUBLISHING_PROPAGATION_ENABLED=false
PUBLISHING_PROPAGATION_LEASE_DURATION=30s
PUBLISHING_PROPAGATION_INITIAL_BACKOFF=5s
PUBLISHING_PROPAGATION_MAX_ATTEMPTS=8
PUBLISHING_PROPAGATION_POLL_INTERVAL=2s
NEXT_ISR_REVALIDATE_ENDPOINT=https://web.example.com/api/internal/revalidate
NEXT_ISR_REVALIDATE_TOKEN=replace-with-random-32-plus-character-token

MODERATION_QUEUE_CLAIM_LEASE=15m

ANALYTICS_RAW_EVENT_RETENTION=90d
ANALYTICS_VALIDATION_ENABLED=false
ANALYTICS_VALIDATION_READINESS_DELAY=2m
ANALYTICS_VALIDATION_LEASE=1m
ANALYTICS_VALIDATION_RETRY_DELAY=30s

NOTIFICATION_DELIVERY_ENABLED=false
NOTIFICATION_EMAIL_PROVIDER_ENDPOINT=https://email-provider.example.com/send
NOTIFICATION_EMAIL_PROVIDER_TOKEN=replace-with-email-provider-token-32-plus
NOTIFICATION_PUSH_PROVIDER_ENDPOINT=https://push-provider.example.com/send
NOTIFICATION_PUSH_PROVIDER_TOKEN=replace-with-push-provider-token-32-plus
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=replace-with-vapid-public-key

CLOUDFLARE_ACCOUNT_ID=change-me
CLOUDFLARE_ZONE_ID=change-me
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-api-token-32-plus
CLOUDFLARE_PURGE_ENDPOINT=https://api.cloudflare.com/client/v4/zones/change-me/purge_cache

TOPUP_DISCOUNT_PERCENT=10
TOPUP_REQUEST_TTL_MINUTES=30
WITHDRAWAL_MIN_XU=100000
WITHDRAWAL_FEE_THRESHOLD_XU=1000000
WITHDRAWAL_FEE_XU=20000

OTEL_SERVICE_NAME=story-platform-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_TRACES_EXPORT_ENABLED=false
OTEL_METRICS_EXPORT_ENABLED=false
OTEL_TRACES_SAMPLING_PROBABILITY=0.1
OTEL_METRICS_EXPORT_INTERVAL=30s
